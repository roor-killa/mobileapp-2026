generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  pseudonym    String?  @unique // Pseudo pour les virements (ex: JeanD)
  iban         String?  @unique // IBAN unique NodEX (ex: FR76 3000 6000 01XX XXXX XXXX XXX)
  appwriteId   String?  @unique // id utilisateur Appwrite Auth (pour connexion via l'app)
  balanceEur   Decimal  @default(2000) // Solde EUR pour virements NodEX
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  wallets      Wallet[]
  card         UserCard?
}

model UserCard {
  id           String   @id @default(uuid())
  userId       String   @unique
  cardNumber   String   // 16 chiffres (Visa 4xxx), format Luhn valide
  last4        String   // 4 derniers chiffres pour affichage masqué
  expiryMonth  Int      // 01-12
  expiryYear   Int      // ex: 28 pour 2028
  cvv          String   // 3 chiffres
  pin          String   // 4 chiffres (code PIN carte)
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model VirementEur {
  id         String   @id @default(uuid())
  fromUserId String
  toUserId   String
  amount     Decimal
  createdAt  DateTime @default(now())

  @@index([fromUserId])
  @@index([toUserId])
}

model Wallet {
  id             String        @id @default(uuid())
  userId         String
  chain          String        // ETH, SOL ou BTC
  address        String
  keyShareServer String        // Moitié serveur de la clé privée (chiffrée)
  createdAt      DateTime      @default(now())
  user           User          @relation(fields: [userId], references: [id])
  transactions   Transaction[]

  @@index([userId])
}

model Transaction {
  id          String   @id @default(uuid())
  walletId    String
  txHash      String?
  chain       String
  type        String   // "send" ou "receive"
  amount      Decimal
  tokenSymbol String
  toAddress   String
  fromAddress String
  status      String   @default("pending") // pending, confirmed, failed
  createdAt   DateTime @default(now())
  wallet      Wallet   @relation(fields: [walletId], references: [id])

  @@index([walletId])
}

model PriceCache {
  id        String   @id @default(uuid())
  symbol    String   @unique
  priceEur  Decimal
  updatedAt DateTime @updatedAt
}
