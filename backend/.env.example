# =========================
# Stripe (required)
# =========================
STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=YOUR_STRIPE_WEBHOOK_SECRET

# Optional redirect URLs
STRIPE_SUCCESS_URL=http://localhost:4000/success
STRIPE_CANCEL_URL=http://localhost:4000/cancel

# =========================
# Supabase (required for wallet crediting / admin actions)
# =========================
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# =========================
# Dev behavior
# =========================
# true = also credit wallet when /checkout-status says paid (demo mode)
# false = credit only via webhook (recommended)
CREDIT_ON_STATUS=true

# =========================
# Security / CORS / Rate limit
# =========================
ALLOWED_ORIGINS=*
RATE_LIMIT_MAX=120

# Extra server settings
PORT=4000
EVM_RATE_LIMIT_PER_MIN=10
INITIAL_WALLET_BKN=1500
PUBLIC_BASE_URL=http://localhost:4000

# Optional on-chain / ERC-20 demo
EVM_RPC_URL=https://sepolia.base.org
EVM_CHAIN=base-sepolia
BKN_TOKEN_ADDRESS=YOUR_BKN_TOKEN_ADDRESS
EVM_SIGNER_PRIVATE_KEY=YOUR_TESTNET_PRIVATE_KEY
