# ============================================================
#  BKN BACKEND — Variables d'environnement
#  Copier ce fichier en ".env" dans le dossier Backend/
#  ⚠ Ne JAMAIS committer le fichier .env (il est dans .gitignore)
# ============================================================

# ─────────────────────────────────────────
# BASE DE DONNÉES — Supabase (production)
# ─────────────────────────────────────────
DB_HOST=aws-0-us-west-2.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres.VOTRE_PROJECT_ID
DB_PASSWORD=VOTRE_MOT_DE_PASSE_SUPABASE

# ─────────────────────────────────────────
# BASE DE DONNÉES — PostgreSQL local (Docker)
# Décommenter pour les tests en local
# ─────────────────────────────────────────
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=bkn_db
# DB_USER=bkn_admin
# DB_PASSWORD=BknSecurePass2026!

# ─────────────────────────────────────────
# SÉCURITÉ JWT
# Générer avec : python -c "import secrets; print(secrets.token_hex(32))"
# ─────────────────────────────────────────
JWT_SECRET_KEY=VOTRE_CLE_SECRETE_MINIMUM_32_CARACTERES
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ─────────────────────────────────────────
# SENDGRID — Emails (reset mot de passe)
# Créer un compte sur https://sendgrid.com
# ─────────────────────────────────────────
SENDGRID_API_KEY=SG.VOTRE_CLE_API_SENDGRID
SENDGRID_FROM_EMAIL=noreply@bkn-app.com

# ─────────────────────────────────────────
# API — Configuration serveur
# ─────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=False
