<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bank_surface">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/bank_primary"
        android:padding="28dp"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Banko"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Créer un compte"
            android:textColor="#AAFFFFFF"
            android:textSize="13sp"
            android:layout_marginTop="4dp"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Carte formulaire -->
            <androidx.cardview.widget.CardView
                xmlns:app="http://schemas.android.com/apk/res-auto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/bank_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NOM COMPLET"
                        android:textColor="@color/bank_muted"
                        android:textSize="11sp"
                        android:letterSpacing="0.08"
                        android:layout_marginBottom="6dp"/>

                    <EditText
                        android:id="@+id/etRegisterName"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:inputType="textPersonName"
                        android:textSize="14sp"
                        android:background="@drawable/bg_input_outline"
                        android:paddingHorizontal="14dp"
                        android:layout_marginBottom="16dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ADRESSE EMAIL"
                        android:textColor="@color/bank_muted"
                        android:textSize="11sp"
                        android:letterSpacing="0.08"
                        android:layout_marginBottom="6dp"/>

                    <EditText
                        android:id="@+id/etRegisterEmail"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:inputType="textEmailAddress"
                        android:textSize="14sp"
                        android:background="@drawable/bg_input_outline"
                        android:paddingHorizontal="14dp"
                        android:layout_marginBottom="16dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MOT DE PASSE"
                        android:textColor="@color/bank_muted"
                        android:textSize="11sp"
                        android:letterSpacing="0.08"
                        android:layout_marginBottom="6dp"/>

                    <EditText
                        android:id="@+id/etRegisterPassword"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:inputType="textPassword"
                        android:textSize="14sp"
                        android:background="@drawable/bg_input_outline"
                        android:paddingHorizontal="14dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <Button
                android:id="@+id/btnRegister"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="Créer mon compte"
                android:backgroundTint="@color/bank_primary"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Déjà un compte ? Se connecter"
                android:textColor="@color/bank_accent"
                android:textSize="13sp"
                android:gravity="center"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>