<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bank_surface">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/bank_primary"
        android:padding="24dp"
        android:gravity="center">

        <TextView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:gravity="center"
            android:text="👤"
            android:textSize="28sp"
            android:background="@drawable/circle_background"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mon Profil"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Carte infos -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/bank_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Informations personnelles"
                        android:textColor="@color/bank_muted"
                        android:textSize="11sp"
                        android:letterSpacing="0.05"
                        android:padding="14dp"
                        android:paddingBottom="4dp"/>

                    <!-- Nom -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="10dp">
                        <TextView
                            android:layout_width="80dp"
                            android:layout_height="wrap_content"
                            android:text="Nom"
                            android:textColor="@color/bank_muted"
                            android:textSize="13sp"/>
                        <EditText
                            android:id="@+id/etProfileName"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Nom complet"
                            android:background="@null"
                            android:textSize="13sp"
                            android:textColor="@color/bank_text"
                            android:textStyle="bold"
                            android:gravity="end"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="@color/bank_border" android:layout_marginHorizontal="14dp"/>

                    <!-- Email -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="10dp">
                        <TextView
                            android:layout_width="80dp"
                            android:layout_height="wrap_content"
                            android:text="Email"
                            android:textColor="@color/bank_muted"
                            android:textSize="13sp"/>
                        <EditText
                            android:id="@+id/etProfileEmail"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Email"
                            android:inputType="textEmailAddress"
                            android:background="@null"
                            android:textSize="13sp"
                            android:textColor="@color/bank_text"
                            android:textStyle="bold"
                            android:gravity="end"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="@color/bank_border" android:layout_marginHorizontal="14dp"/>

                    <!-- IBAN -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="12dp">
                        <TextView
                            android:layout_width="80dp"
                            android:layout_height="wrap_content"
                            android:text="IBAN"
                            android:textColor="@color/bank_muted"
                            android:textSize="13sp"/>
                        <TextView
                            android:id="@+id/tvIban"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="—"
                            android:textColor="@color/bank_accent"
                            android:textSize="11sp"
                            android:fontFamily="monospace"
                            android:gravity="end"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Bouton Enregistrer -->
            <Button
                android:id="@+id/btnUpdateProfile"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Enregistrer les modifications"
                android:backgroundTint="@color/bank_primary"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:layout_marginBottom="10dp"/>

            <!-- Bouton Mot de passe -->
            <Button
                android:id="@+id/btnChangePassword"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Changer le mot de passe"
                android:backgroundTint="@color/bank_surface"
                android:textColor="@color/bank_primary"
                android:textSize="14sp"
                android:layout_marginBottom="10dp"/>

            <!-- Bouton Déconnexion -->
            <Button
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Se déconnecter"
                android:backgroundTint="@color/bank_surface"
                android:textColor="@color/bank_danger"
                android:textSize="14sp"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>