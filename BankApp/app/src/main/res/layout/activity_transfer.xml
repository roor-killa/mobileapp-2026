<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bank_surface">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/bank_primary"
        android:padding="16dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nouveau Virement"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Carte formulaire -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/bank_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Montant -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MONTANT"
                        android:textColor="@color/bank_muted"
                        android:textSize="11sp"
                        android:letterSpacing="0.08"
                        android:layout_marginBottom="8dp"/>

                    <EditText
                        android:id="@+id/etAmount"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:hint="0,00 €"
                        android:inputType="numberDecimal"
                        android:textSize="24sp"
                        android:textColor="@color/bank_primary"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:background="@drawable/bg_input_outline"
                        android:layout_marginBottom="20dp"/>

                    <!-- Destinataire -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DESTINATAIRE (EMAIL)"
                        android:textColor="@color/bank_muted"
                        android:textSize="11sp"
                        android:letterSpacing="0.08"
                        android:layout_marginBottom="8dp"/>

                    <EditText
                        android:id="@+id/etRecipient"
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:hint="ami@example.com"
                        android:inputType="textEmailAddress"
                        android:textSize="15sp"
                        android:textColor="@color/bank_text"
                        android:background="@drawable/bg_input_outline"
                        android:paddingHorizontal="14dp"
                        android:layout_marginBottom="6dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Entrez l'email du bénéficiaire"
                        android:textColor="@color/bank_muted"
                        android:textSize="11sp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Bouton confirmer -->
            <Button
                android:id="@+id/btnConfirmTransfer"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Confirmer le virement"
                android:backgroundTint="@color/bank_primary"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>