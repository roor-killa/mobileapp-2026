<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bank_surface">

    <!-- HEADER BLEU -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/bank_primary"
        android:paddingTop="48dp"
        android:paddingBottom="32dp"
        android:gravity="center">

        <ImageView
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:src="@drawable/logo_bank"
            android:scaleType="centerInside"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BANKO"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:letterSpacing="0.1"/>
    </LinearLayout>

    <!-- FORMULAIRE -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/bank_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ADRESSE EMAIL"
                        android:textColor="@color/bank_muted"
                        android:textSize="11sp"
                        android:letterSpacing="0.08"
                        android:layout_marginBottom="6dp"/>

                    <EditText
                        android:id="@+id/etEmail"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:inputType="textEmailAddress"
                        android:textSize="14sp"
                        android:textColor="@color/bank_text"
                        android:background="@drawable/bg_input_outline"
                        android:paddingHorizontal="14dp"
                        android:layout_marginBottom="16dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MOT DE PASSE"
                        android:textColor="@color/bank_muted"
                        android:textSize="11sp"
                        android:letterSpacing="0.08"
                        android:layout_marginBottom="6dp"/>

                    <EditText
                        android:id="@+id/etPassword"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:inputType="textPassword"
                        android:textSize="14sp"
                        android:textColor="@color/bank_text"
                        android:background="@drawable/bg_input_outline"
                        android:paddingHorizontal="14dp"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:id="@+id/tvForgotPassword"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mot de passe oublié ?"
                        android:textColor="@color/bank_accent"
                        android:textSize="12sp"
                        android:padding="4dp"
                        android:layout_gravity="end"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <Button
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="SE CONNECTER"
                android:backgroundTint="@color/bank_primary"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/tvSignUp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pas de compte ? Inscrivez-vous ici"
                android:textColor="@color/bank_accent"
                android:textSize="13sp"
                android:textStyle="bold"
                android:gravity="center"
                android:padding="8dp"/>

        </LinearLayout>
    </ScrollView>

</LinearLayout>