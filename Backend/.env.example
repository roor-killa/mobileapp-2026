APP_NAME=MoneyTransferApp
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Europe/Paris

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── Base de données PostgreSQL ───────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=moneytransfer
DB_USERNAME=moneytransfer_user
DB_PASSWORD=secret

# ─── Redis (Sessions & Cache) ─────────────────────────────────────────────────
CACHE_DRIVER=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─── Mail (optionnel) ─────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@moneytransfer.local"
MAIL_FROM_NAME="${APP_NAME}"

# ─── Sanctum (Auth API) ───────────────────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:8080

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_KEY=pk_test_your_publishable_key
STRIPE_SECRET=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ─── Ollama (Chatbot IA) ──────────────────────────────────────────────────────
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=llama3.2

# ─── QR Code ──────────────────────────────────────────────────────────────────
QR_TOKEN_TTL=10
QR_HMAC_SECRET=change_me_with_random_secret_32_chars
